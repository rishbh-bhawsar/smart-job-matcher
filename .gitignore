# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ==========================================
# Environment & Secrets (NEVER commit secrets!)
# ==========================================
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt

# ==========================================
# Build Outputs & Compiled Code
# ==========================================
dist/
build/
out/
out-tsc/
bazel-out/
.angular/
.sass-cache/
*.tsbuildinfo

# ==========================================
# Logs & Process Files
# ==========================================
logs/
*.log
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
*.lcov
.nyc_output/
testem.log
.history/
__screenshots__/

# ==========================================
# Temporary Files & Caches
# ==========================================
tmp/
temp/
.cache/
*.swp
*.swo
*~

# ==========================================
# Database & Local Dumps
# ==========================================
*.sqlite
*.sqlite3
*.db
dump.rdb

# ==========================================
# IDE & Editor Settings
# ==========================================
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
.c9/

# VS Code (ignore user state, preserve workspace configs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==========================================
# Operating System Artifacts
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

