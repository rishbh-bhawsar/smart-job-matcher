{
	"info": {
		"_postman_id": "7b3df69e-d375-408a-b851-93e110cb105e",
		"name": "Smart Job Matcher API",
		"description": "Postman Collection for **Smart Job Matcher** Backend REST API.\n\n### Features\n- **Health Check**: Server alive check\n- **Profile Management**: View and update candidate profile, skills, target job titles, and minimum match score\n- **Jobs Management**: Query scored and matched jobs with status & score filtering, update application statuses\n- **Notifications**: View match alerts and mark as read\n- **Job Sync & AI Matching**: Trigger manual on-demand scrape across Remotive, RemoteOK, Adzuna, and Email alerts, followed by OpenAI job matching\n\n### Authentication\nAll endpoints under `/api/*` require the `x-api-key` header matching the `API_KEY` defined in the Backend `.env`.\nThe collection uses the `{{apiKey}}` collection variable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "x-api-key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{apiKey}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string",
			"description": "Base URL of the backend server"
		},
		{
			"key": "apiKey",
			"value": "change_me_to_a_long_random_string",
			"type": "string",
			"description": "API key matching process.env.API_KEY in Backend/.env"
		},
		{
			"key": "jobId",
			"value": "1",
			"type": "string",
			"description": "Sample job ID for status update"
		},
		{
			"key": "notificationId",
			"value": "1",
			"type": "string",
			"description": "Sample notification ID for marking read"
		}
	],
