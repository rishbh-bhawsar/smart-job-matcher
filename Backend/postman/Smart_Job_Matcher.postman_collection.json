		{
			"name": "Sync",
			"item": [
				{
					"name": "Trigger Job Sync & Matching",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/sync/run",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sync",
								"run"
							]
						},
						"description": "Manually triggers the background sync job pipeline:\n1. Fetches new jobs from Remotive, RemoteOK, Adzuna, and Email alerts\n2. Filters and de-duplicates them\n3. Runs OpenAI to calculate match score, reason, matched skills, and missing skills\n4. Saves match scores in database\n5. Sends email/in-app notifications for matches above `min_score`\n\nReturns `{ \"fetched\": <count>, \"matched\": <count> }`."
					},
					"response": [
						{
							"name": "200 OK - Sync Completed",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "x-api-key",
										"value": "{{apiKey}}"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/api/sync/run",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"sync",
										"run"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json; charset=utf-8"
								}
							],
							"body": "{\n  \"fetched\": 8,\n  \"matched\": 2\n}"
						},
						{
							"name": "409 Conflict - Sync Already Running",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "x-api-key",
