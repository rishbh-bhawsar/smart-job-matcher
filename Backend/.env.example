# ---------- Server ----------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Simple protection for the API (send as x-api-key header from Angular)
API_KEY=change_me_to_a_long_random_string

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=ai_job_radar

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=your_model_name_here

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
NOTIFY_EMAIL=youraddress@gmail.com

# ---------- Cron ----------
# Every 60 minutes. Use */5 * * * * while testing.
CRON_SCHEDULE=0 * * * *
CRON_ENABLED=true